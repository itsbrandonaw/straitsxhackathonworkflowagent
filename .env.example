NODE_ENV=development
PORT=3001
HOST=127.0.0.1
SCOUT_MODE=mock
LOCAL_BROWSER_HEADLESS=true
LOCAL_EXTRACTION_MODE=ollama
LOCAL_DATA_DIR=.happy-data
MAX_CONCURRENT_ITEMS=2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=replace-with-installed-local-model
PUBLIC_API_URL=http://localhost:3001
LOCAL_SMOKE_VIEWER_PORT=3002
LOCAL_SMOKE_HOLD_MS=60000
LOCAL_SMOKE_TARGET_SETTLE_MS=5000
SMOKE_PRODUCT_QUERY=wireless mechanical keyboard
SMOKE_TARGET_SITE=shopee.sg
SMOKE_TARGET_LABEL=Shopee
SMOKE_TARGET_URL=https://shopee.sg/search?keyword=wireless%20mechanical%20keyboard
AWS_REGION=ap-southeast-1
HAPPY_AWS_REGION=ap-southeast-1
BEDROCK_MODEL_ID=replace-with-enabled-bedrock-model-id
AGENTCORE_RUNTIME_ARN=replace-with-agentcore-runtime-arn
AGENTCORE_BROWSER_ID=aws.browser.v1
SCOUTS_TABLE_NAME=happy-scouts-state
SCOUTS_SCREENSHOT_BUCKET=replace-with-screenshot-bucket
WEBSOCKET_MANAGEMENT_ENDPOINT=replace-with-websocket-management-endpoint
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/v1/events
